/* TOA3 generated QSS — do not edit; edit JSON + regen */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #323130;
}

/* 必须显式覆盖：否则 Windows 白底 ToolTip 会继承 * 的浅色字 → 看不见 */
QToolTip {
    background-color: #323130;
    color: #FFFFFF;
    border: 1px solid #EDEBE9;
    padding: 6px 10px;
    border-radius: 4px;
}

QMainWindow, QWidget#PageRoot {
    background: #FFFFFF;
}

QDialog, QDialog#ThemedDialog {
    background: #F8F8F8;
    color: #323130;
}

QDialog QLabel {
    color: #323130;
}

QDialog QLabel[class="hint"] {
    color: #605E5C;
}

QLabel[class="page-title"] {
    font-size: 14pt;
    font-weight: 700;
    color: #323130;
}

QLabel[class="section-title"] {
    font-size: 12pt;
    font-weight: 700;
    color: #323130;
}

QLabel[class="hint"] {
    font-size: 9pt;
    color: #605E5C;
}

QLabel[class="semantic-success"] {
    background: #DFF6DD;
    color: #107C10;
    padding: 8px 12px;
    border-radius: 4px;
}

QLabel[class="semantic-warning"] {
    background: #FFF4CE;
    color: #916900;
    padding: 8px 12px;
    border-radius: 4px;
}

QLabel[class="semantic-danger"] {
    background: #FDE7E9;
    color: #D13438;
    padding: 8px 12px;
    border-radius: 4px;
}

QLabel[class="semantic-info"] {
    background: #DEECF9;
    color: #006ABC;
    padding: 8px 12px;
    border-radius: 4px;
}

QLabel[class="semantic-success"][compact="true"],
QLabel[class="semantic-warning"][compact="true"],
QLabel[class="semantic-danger"][compact="true"],
QLabel[class="semantic-info"][compact="true"] {
    padding: 2px 8px;
    font-size: 9pt;
    min-height: 18px;
}

QPushButton {
    min-height: 28px;
    padding: 4px 12px;
    border: 1px solid #EDEBE9;
    border-radius: 4px;
    background: #F8F8F8;
    color: #323130;
    outline: none;
}

QPushButton:focus {
    outline: none;
}

QPushButton:hover {
    background: #F3F2F1;
    border-color: #0078D4;
    color: #323130;
}

QPushButton:pressed {
    background: #E1DFDD;
}

QPushButton:disabled {
    background: #F3F3F3;
    color: #908F8D;
    border-color: #EDEBE9;
}

/* 带菜单的按钮：右侧三角垂直居中（修复默认偏下） */
QPushButton[hasMenu="true"] {
    padding-right: 22px;
}

QPushButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 10px;
    height: 10px;
    right: 8px;
    top: 50%;
    margin-top: -5px;
}

QToolButton {
    outline: none;
}

QToolButton:focus {
    outline: none;
}

/* 通用 ToolButton 菜单三角居中（壳层/更多等） */
QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 10px;
    height: 10px;
    right: 6px;
    top: 50%;
    margin-top: -5px;
}

QAbstractButton:focus {
    outline: none;
}

QPushButton[class="primary"] {
    background: #0078D4;
    color: #FFFFFF;
    border: 1px solid #0078D4;
    font-weight: 600;
}

QPushButton[class="primary"]:hover {
    background: #106EBE;
    border-color: #106EBE;
}

QPushButton[class="primary"]:pressed {
    background: #005A9E;
}

QPushButton[class="danger"] {
    background: #D13438;
    color: #FFFFFF;
    border: 1px solid #D13438;
    font-weight: 600;
}

QPushButton[class="msg-info"],
QPushButton[class="msg-confirm"] {
    background: #0078D4;
    color: #FFFFFF;
    border: 1px solid #0078D4;
    font-weight: 600;
}

QPushButton[class="msg-warning"] {
    background: #F0A020;
    color: #FFFFFF;
    border: 1px solid #F0A020;
    font-weight: 600;
}

QPushButton[class="msg-error"] {
    background: #E81123;
    color: #FFFFFF;
    border: 1px solid #E81123;
    font-weight: 600;
}

QPushButton[class="msg-success"] {
    background: #107C10;
    color: #FFFFFF;
    border: 1px solid #107C10;
    font-weight: 600;
}

QLineEdit {
    min-height: 32px;
    padding: 4px 10px;
    background: #FFFFFF;
    color: #323130;
    border: 1px solid #8A8886;
    border-radius: 4px;
    selection-background-color: #EDE7F6;
}

QComboBox, QSpinBox, QDateEdit {
    min-height: 32px;
    padding: 4px 10px;
    background: #FFFFFF;
    color: #323130;
    border: 1px solid #8A8886;
    border-radius: 4px;
    selection-background-color: #EDE7F6;
}

QComboBox {
    padding-right: 36px;
}

QComboBox:hover {
    border: 1px solid #0078D4;
}

QSpinBox, QDateEdit {
    padding-right: 36px;
}

QSpinBox, QDateEdit {
    padding-right: 36px;
}

QSpinBox#ThemedSpinBoxField {
    min-height: 26px;
    max-height: 32px;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    color: #323130;
    font-weight: 500;
}

QSpinBox#ThemedSpinBoxField:focus {
    border: none;
}

QWidget#ThemedSpinBox {
    background: #FFFFFF;
    color: #323130;
    border: 1px solid #8A8886;
    border-radius: 4px;
    min-height: 32px;
    max-height: 36px;
}

QWidget#ThemedSpinBox:hover {
    border: 1px solid #0078D4;
}

QWidget#ThemedSpinBox[focusRing="true"] {
    border: 1px solid #0078D4;
}

QToolButton#SpinBoxUpButton, QToolButton#SpinBoxDownButton {
    background: #FFFFFF;
    border: none;
    border-radius: 2px;
    padding: 0;
    margin: 0;
    min-width: 22px;
    max-width: 22px;
}

QToolButton#SpinBoxUpButton:hover, QToolButton#SpinBoxDownButton:hover {
    background: #F3F2F1;
}

QToolButton#SpinBoxUpButton:pressed, QToolButton#SpinBoxDownButton:pressed {
    background: #E1DFDD;
}

QSpinBox {
    padding-right: 44px;
    color: #323130;
    font-weight: 500;
}

QSpinBox::line-edit, QSpinBox QLineEdit {
    background: transparent;
    color: #323130;
    border: none;
    padding: 2px 8px;
    selection-background-color: #EDE7F6;
    selection-color: #323130;
}

QSpinBox:hover {
    border: 1px solid #0078D4;
}

QSpinBox:focus {
    border: 1px solid #0078D4;
    color: #323130;
}

QSpinBox::up-button {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    height: 12px;
    margin-top: 4px;
    margin-right: 4px;
    border: none;
    border-radius: 3px;
    background: #FFFFFF;
}

QSpinBox::down-button {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 30px;
    height: 12px;
    margin-bottom: 4px;
    margin-right: 4px;
    border: none;
    border-radius: 3px;
    background: #FFFFFF;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: #F3F2F1;
}

QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background: #E1DFDD;
}

QSpinBox::up-arrow {
    image: url(C:/Users/43594/Desktop/YCZH-TDP/TOA3/resources/qss/arrows/office_2019_colorful/chevron_up.png);
    width: 12px;
    height: 12px;
}

QSpinBox::down-arrow {
    image: url(C:/Users/43594/Desktop/YCZH-TDP/TOA3/resources/qss/arrows/office_2019_colorful/chevron_down.png);
    width: 12px;
    height: 12px;
}

QDateEdit:hover {
    border: 1px solid #0078D4;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: none;
    background: transparent;
}

QComboBox::drop-down:hover {
    background: transparent;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    color: #323130;
    border: 1px solid #8A8886;
    selection-background-color: #EDE7F6;
    selection-color: #323130;
    outline: 0;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 6px 10px;
}

QComboBox::down-arrow {
    image: url(C:/Users/43594/Desktop/YCZH-TDP/TOA3/resources/qss/arrows/office_2019_colorful/chevron_down.png);
    width: 12px;
    height: 12px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 8px;
    top: 50%;
    margin-top: -6px;
}

/* 一体式 DateEdit：外框像输入框，内嵌无边日期字 + 日历图标 */
QWidget#DateEdit {
    background: #FFFFFF;
    color: #323130;
    border: 1px solid #8A8886;
    border-radius: 4px;
    min-height: 32px;
    max-height: 36px;
}

QWidget#DateEdit:hover,
QWidget#DateEdit:focus {
    border: 1px solid #0078D4;
}

QLineEdit#DateEditField {
    background: transparent;
    border: none;
    padding: 2px 4px;
    min-height: 26px;
    color: #323130;
    selection-background-color: #EDE7F6;
}

QLineEdit#DateEditField:focus,
QLineEdit#DateEditField:hover {
    border: none;
    background: transparent;
}

QToolButton#DateEditButton {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 2px 0 0;
    min-width: 28px;
    max-width: 30px;
    min-height: 26px;
    max-height: 28px;
}

QToolButton#DateEditButton:hover,
QToolButton#DateEditButton:pressed {
    background: transparent;
    border: none;
}

QDateEdit::up-button, QDateEdit::down-button {
    subcontrol-origin: padding;
    width: 26px;
    border: none;
    background: transparent;
}

QDateEdit::up-button {
    subcontrol-position: top right;
    height: 50%;
    border-top-right-radius: 3px;
}

QDateEdit::down-button {
    subcontrol-position: bottom right;
    height: 50%;
    border-bottom-right-radius: 3px;
}

QDateEdit::up-button:hover, QDateEdit::down-button:hover,
QDateEdit::up-button:pressed, QDateEdit::down-button:pressed {
    background: transparent;
}

QDateEdit::up-arrow {
    image: url(C:/Users/43594/Desktop/YCZH-TDP/TOA3/resources/qss/arrows/office_2019_colorful/chevron_up.png);
    width: 10px;
    height: 10px;
}

QDateEdit::down-arrow {
    image: url(C:/Users/43594/Desktop/YCZH-TDP/TOA3/resources/qss/arrows/office_2019_colorful/chevron_down.png);
    width: 10px;
    height: 10px;
}

QDateEdit::drop-down {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 28px;
    border: none;
    background: transparent;
}

QLineEdit:focus {
    border: 1px solid #0078D4;
}

QComboBox:focus, QSpinBox:focus, QDateEdit:focus {
    border: 1px solid #0078D4;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDateEdit:disabled, QWidget#DateEdit:disabled, QWidget#ThemedSpinBox:disabled {
    background: #F3F3F3;
    color: #908F8D;
}

QTextEdit, QPlainTextEdit {
    min-height: 80px;
    padding: 8px 10px;
    background: #FFFFFF;
    color: #323130;
    border: 1px solid #8A8886;
    border-radius: 4px;
    selection-background-color: #EDE7F6;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #0078D4;
}

QTextEdit:disabled, QPlainTextEdit:disabled {
    background: #F3F3F3;
    color: #908F8D;
}

QListWidget {
    background: #F8F8F8;
    color: #323130;
    border: 1px solid #EDEBE9;
    border-radius: 4px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background: #EDE7F6;
    color: #323130;
}

QListWidget::item:hover {
    background: #F3F2F1;
    color: #323130;
}

QTreeWidget {
    background: #F8F8F8;
    color: #323130;
    border: 1px solid #EDEBE9;
    border-radius: 4px;
    alternate-background-color: #FFFFFF;
    outline: none;
}

QTreeWidget::item {
    min-height: 28px;
    padding: 2px 4px;
}

QTreeWidget::item:selected {
    background: #EDE7F6;
    color: #323130;
}

QTreeWidget::item:hover {
    background: #F3F2F1;
    color: #323130;
}

/* 记事大纲：卡片容器 + 轻选中，层级线更清晰 */
QWidget#OutlineTreePanel {
    background: #FFFFFF;
    border: 1px solid #EDEBE9;
    border-radius: 10px;
    padding: 2px;
}

QWidget#OutlineTreeHeader {
    padding: 0 2px 2px 2px;
}

QTreeWidget#OutlineTree {
    alternate-background-color: transparent;
    background: transparent;
    border: none;
    outline: none;
    show-decoration-selected: 1;
}

QTreeWidget#OutlineTree::item {
    min-height: 34px;
    padding: 5px 10px;
    border-left: 3px solid transparent;
    border-radius: 6px;
    margin: 2px 4px;
}

QTreeWidget#OutlineTree::item:hover {
    background: #F3F2F1;
    color: #323130;
    border-left: 3px solid #EDEBE9;
}

QTreeWidget#OutlineTree::item:selected,
QTreeWidget#OutlineTree::item:selected:hover,
QTreeWidget#OutlineTree::item:selected:active {
    background: #0078D4;
    color: #FFFFFF;
    border-left: 3px solid #0078D4;
    font-weight: 600;
}

QWidget#NotepadToolbar {
    background: #FFFFFF;
    border: 1px solid #EDEBE9;
    border-radius: 10px;
}

LineEdit#NotepadSearchEdit {
    min-height: 32px;
    border-radius: 8px;
}

QWidget#NotepadEditorChrome {
    background: #FFFFFF;
    border: 1px solid #EDEBE9;
    border-radius: 10px;
}

QWidget#NotepadEditorSurface {
    background: #F8F8F8;
    border: 1px solid #EDEBE9;
    border-radius: 10px;
}

QWidget#NotepadFmtToolbar {
    background: #FFFFFF;
    border: 1px solid #EDEBE9;
    border-radius: 8px;
}

QWidget#NotepadEditorFooter {
    border-top: 1px solid #EDEBE9;
    padding-top: 2px;
}

PlainTextEdit#MarkdownSourceEdit,
TextEdit#MarkdownPreviewEdit,
TextEdit#MarkdownDesignEdit {
    border: none;
    border-radius: 6px;
    padding: 10px 12px;
    background: transparent;
}

QWidget#EditorViewTabs {
    background: #FFFFFF;
    border: 1px solid #EDEBE9;
    border-radius: 999px;
    padding: 2px;
}

QTabBar#EditorViewTabBar {
    background: transparent;
}

QTabBar#EditorViewTabBar::tab {
    min-width: 56px;
    min-height: 28px;
    max-height: 30px;
    padding: 4px 16px;
    margin: 1px;
    background: transparent;
    color: #605E5C;
    border: none;
    border-radius: 999px;
}

QTabBar#EditorViewTabBar::tab:selected {
    background: #F8F8F8;
    color: #0078D4;
    font-weight: 600;
    border: 1px solid #EDEBE9;
}

QTabBar#EditorViewTabBar::tab:hover:!selected {
    background: #EDEBE9;
    color: #323130;
}

QTreeWidget#OutlineTree::branch {
    background: transparent;
}

QTreeWidget#OutlineTree::branch:has-siblings:!adjoins-item {
    border-image: none;
    border-left: 1px solid #EDEBE9;
}

QTreeWidget#OutlineTree::branch:has-siblings:adjoins-item {
    border-image: none;
    border-left: 1px solid #EDEBE9;
}

QTreeWidget#OutlineTree::branch:!has-children:!has-siblings:adjoins-item {
    border-image: none;
    border-left: 1px solid #EDEBE9;
}

QDialog#MessageDialog {
    background: #F8F8F8;
    color: #323130;
}

QCheckBox, QRadioButton {
    spacing: 8px;
    min-height: 28px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #8A8886;
    border-radius: 4px;
    background: #F8F8F8;
}

QCheckBox::indicator:hover {
    border-color: #0078D4;
}

QCheckBox::indicator:checked {
    border: 2px solid #0078D4;
    background: #0078D4;
    image: url(C:/Users/43594/Desktop/YCZH-TDP/TOA3/resources/qss/arrows/office_2019_colorful/check_on.png);
}

QCheckBox::indicator:disabled {
    border-color: #EDEBE9;
    background: #EDEBE9;
}

QCheckBox::indicator:checked:disabled {
    border-color: #EDEBE9;
    background: #EDEBE9;
    image: url(C:/Users/43594/Desktop/YCZH-TDP/TOA3/resources/qss/arrows/office_2019_colorful/check_on.png);
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #8A8886;
    border-radius: 9px;
    background: #F8F8F8;
}

QRadioButton::indicator:hover {
    border-color: #0078D4;
}

QRadioButton::indicator:checked {
    border: none;
    background: transparent;
    image: url(C:/Users/43594/Desktop/YCZH-TDP/TOA3/resources/qss/arrows/office_2019_colorful/radio_on.png);
}

QSlider::groove:horizontal {
    height: 6px;
    background: #EDEBE9;
    border: 1px solid #EDEBE9;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #0078D4;
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background: #EDEBE9;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background: #0078D4;
    border: 1px solid #0078D4;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #106EBE;
    border-color: #106EBE;
}

QSlider::groove:vertical {
    width: 6px;
    background: #EDEBE9;
    border: 1px solid #EDEBE9;
    border-radius: 3px;
}

QSlider::handle:vertical {
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    background: #0078D4;
    border-radius: 8px;
}

QProgressBar {
    min-height: 12px;
    border: 1px solid #EDEBE9;
    border-radius: 4px;
    background: #EDEBE9;
    text-align: center;
}

QProgressBar::chunk {
    background: #0078D4;
    border-radius: 3px;
}

/* 日历 / 日期弹层：与主题同色，禁止系统白底浅字 */
QCalendarWidget {
    background: #F8F8F8;
    color: #323130;
    border: 1px solid #EDEBE9;
    border-radius: 6px;
}

QCalendarWidget QWidget {
    alternate-background-color: #FFFFFF;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: #0078D4;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    min-height: 36px;
}

QCalendarWidget QToolButton {
    color: #FFFFFF;
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: 600;
    min-width: 28px;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px 4px;
    min-width: 26px;
    max-width: 26px;
    min-height: 28px;
    max-height: 28px;
    icon-size: 14px 14px;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth:hover,
QCalendarWidget QToolButton#qt_calendar_nextmonth:hover {
    background: #EDEBE9;
    color: #323130;
}

QCalendarWidget QToolButton:hover {
    background: #EDEBE9;
    color: #323130;
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;
    width: 0;
}

QCalendarWidget QSpinBox {
    background: #FFFFFF;
    color: #323130;
    border: 1px solid #8A8886;
    border-radius: 4px;
    selection-background-color: #EDE7F6;
}

QCalendarWidget QAbstractItemView {
    background: #F8F8F8;
    color: #323130;
    outline: none;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
    font-size: 10pt;
}

QCalendarWidget#ThemedCalendar QTableView {
    border: 1px solid #EDEBE9;
    margin: 4px 6px 6px 6px;
    gridline-color: #EDEBE9;
    background: #F8F8F8;
}

QCalendarWidget#ThemedCalendar QAbstractItemView {
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #323130;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #908F8D;
}

QCalendarWidget QMenu {
    background: #F8F8F8;
    color: #323130;
    border: 1px solid #EDEBE9;
}

QCalendarWidget QMenu::item:selected {
    background: #0078D4;
    color: #FFFFFF;
}

QTableWidget {
    gridline-color: #EDEBE9;
    background: #F8F8F8;
    alternate-background-color: #FAFAFA;
    selection-background-color: #EDE7F6;
    selection-color: #323130;
}

QHeaderView::section {
    background: #0078D4;
    color: #FFFFFF;
    padding: 8px;
    border: none;
    font-weight: 600;
}

QTabWidget::pane {
    border: 1px solid #EDEBE9;
    background: #F8F8F8;
}

QTabBar {
    outline: none;
}

QTabBar::tab {
    min-height: 26px;
    max-height: 28px;
    padding: 3px 12px;
    background: #FFFFFF;
    color: #605E5C;
    border: 1px solid #EDEBE9;
    margin-right: 2px;
    outline: none;
}

QTabBar::tab:selected {
    background: #F8F8F8;
    color: #0078D4;
    border-bottom: 2px solid #0078D4;
}

QTabBar::tab:focus,
QTabBar::tab:focus:selected {
    outline: none;
    border: 1px solid #EDEBE9;
}

QTabBar::tab:focus:selected {
    border-bottom: 2px solid #0078D4;
}

QGroupBox {
    font-size: 12px;
    font-weight: 600;
    border: 1px solid #EDEBE9;
    border-radius: 6px;
    margin-top: 18px;
    padding: 14px 10px 10px 10px;
    background: #F8F8F8;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 2px 6px;
    background-color: #F8F8F8;
    color: #605E5C;
}

QScrollBar:vertical {
    width: 12px;
    background: #FFFFFF;
}

QScrollBar::handle:vertical {
    background: #C8C6C4;
    min-height: 24px;
    border-radius: 4px;
}

/* Shell chrome */
QWidget#ShellHeader {
    background: #0078D4;
    color: #FFFFFF;
}

QLabel#ShellBrand {
    font-size: 13pt;
    font-weight: 700;
    color: #FFFFFF;
}

QPushButton#ShellLicenseChip {
    min-height: 24px;
    max-height: 26px;
    padding: 2px 10px;
    font-size: 12px;
    border-radius: 4px;
}

QLabel#ShellLogo {
    background: transparent;
    qproperty-alignment: AlignCenter;
}

QToolButton#ShellHeaderBtn::menu-indicator {
    image: none;
    width: 0;
    height: 0;
}

QLabel#ShellUser,
QToolButton#ShellUser {
    color: #FFFFFF;
    background: transparent;
    border: none;
    padding: 2px 10px;
    min-height: 22px;
    max-height: 28px;
    font-size: 12px;
}

QToolButton#ShellUser:hover {
    background: rgba(255, 255, 255, 0.14);
    border-radius: 4px;
}

QWidget#ShellNav {
    background: #F3F2F1;
}

QScrollArea#ShellNavScroll {
    background: #F3F2F1;
    border: none;
}

QScrollArea#ShellNavScroll QWidget {
    background: #F3F2F1;
}

QScrollArea#ShellNavScroll QScrollBar:vertical {
    width: 8px;
    background: #F3F2F1;
    margin: 0px;
}

QScrollArea#ShellNavScroll QScrollBar::handle:vertical {
    background: #C8C6C4;
    min-height: 24px;
    border-radius: 4px;
}

QScrollArea#ShellNavScroll QScrollBar::add-line:vertical,
QScrollArea#ShellNavScroll QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollArea#ShellNavScroll QScrollBar::add-page:vertical,
QScrollArea#ShellNavScroll QScrollBar::sub-page:vertical {
    background: #F3F2F1;
}

QCheckBox#Switch {
    spacing: 0;
    min-height: 28px;
}

QCheckBox#Switch::indicator {
    width: 0;
    height: 0;
    border: none;
    margin: 0;
    padding: 0;
}

QCheckBox#Switch::indicator:checked {
    image: none;
}

QCheckBox#Switch::indicator:disabled {
    image: none;
}

QToolButton#NavCollapseBtn {
    background: transparent;
    color: #323130;
    border: none;
    padding: 0;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}

QToolButton#NavCollapseBtn:hover {
    background: #EDEBE9;
}

QToolButton#NavExpandRail {
    background: #F3F2F1;
    color: #323130;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.10);
    padding: 0;
    min-width: 4px;
    max-width: 4px;
}

QToolButton#NavExpandRail:hover {
    background: #EDEBE9;
}

QWidget#FinderToolbarBar {
    background: #F8F8F8;
    border: 1px solid #EDEBE9;
    border-radius: 8px;
}

QWidget#FinderToolbarModeGroup {
    background: transparent;
}

QWidget#FinderToolbarActionGroup {
    background: transparent;
    border-left: 1px solid #EDEBE9;
    padding-left: 8px;
    margin-left: 2px;
}

QToolButton#FinderToolBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    color: #605E5C;
    min-height: 28px;
}

QToolButton#FinderToolBtn:hover {
    background: #FFFFFF;
    color: #323130;
}

QToolButton#FinderToolBtn:checked {
    background: #0078D4;
    color: #FFFFFF;
}

QToolButton#FinderTagBtn {
    background: transparent;
    border: none;
    border-radius: 17px;
    padding: 4px;
}

QToolButton#FinderTagBtn:hover {
    background: #FFFFFF;
}

QToolButton#FinderTagFilterBtn,
QToolButton#FinderQuickFilterBtn {
    background: #F8F8F8;
    border: 1px solid #D0D5DD;
    border-radius: 11px;
    padding: 0 7px;
    min-height: 20px;
    max-height: 22px;
    font-size: 12px;
    color: #605E5C;
}

QToolButton#FinderTagFilterBtn {
    padding: 0;
    min-width: 22px;
    max-width: 22px;
    border-radius: 11px;
}

QToolButton#FinderTagFilterBtn:hover,
QToolButton#FinderQuickFilterBtn:hover {
    background: #FFFFFF;
    color: #323130;
}

QToolButton#FinderTagFilterBtn:checked,
QToolButton#FinderQuickFilterBtn:checked {
    background: #FFFFFF;
    border-color: #0078D4;
    color: #0078D4;
    font-weight: 500;
}

QToolButton#FinderQuickFilterBtn:disabled {
    color: #605E5C;
    opacity: 0.45;
}

QWidget#FinderFilterBar {
    background: transparent;
    padding: 0 0 2px 0;
}

QWidget#FinderBreadcrumbBar {
    background: transparent;
    padding: 0 0 2px 0;
}

QScrollArea#FinderColumnScroll {
    border: 1px solid #EDEBE9;
    border-radius: 8px;
    background: #FFFFFF;
}

QWidget#FinderColumnHost {
    background: #FFFFFF;
}

QListWidget#FinderColumn {
    background: #F8F8F8;
    border: none;
    border-right: 1px solid #EDEBE9;
    outline: none;
    padding: 6px 0;
}

QListWidget#FinderColumn::item {
    padding: 4px 10px 4px 8px;
    border-radius: 6px;
    min-height: 22px;
    color: #323130;
}

QListWidget#FinderColumn::item:selected {
    background: #0078D4;
    color: #FFFFFF;
}

QListWidget#FinderColumn::item:hover:!selected {
    background: #FFFFFF;
}

QListWidget#FinderFlatList {
    background: transparent;
    border: none;
    outline: none;
    padding: 10px;
}

QListWidget#FinderFlatList::item {
    border-radius: 8px;
    padding: 2px 4px;
    margin: 2px;
    color: #323130;
}

QListWidget#FinderFlatList::item:selected {
    background: #EDE7F6;
    color: #323130;
}

QListWidget#FinderFlatList::item:hover:!selected {
    background: #FFFFFF;
}

QToolButton#FinderBreadcrumbBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #0078D4;
    padding: 2px 6px;
    min-height: 24px;
    font-weight: 500;
}

QToolButton#FinderBreadcrumbBtn:hover {
    background: #FFFFFF;
    text-decoration: underline;
}

QLabel#FinderBreadcrumbSep {
    color: #605E5C;
    padding: 0 2px;
    background: transparent;
}

QLabel#FinderBreadcrumbCurrent {
    color: #323130;
    font-weight: 600;
    padding: 2px 4px;
    background: transparent;
}

QToolButton#FinderBreadcrumbRootBtn {
    background: transparent;
    border: 1px dashed #EDEBE9;
    border-radius: 4px;
    color: #0078D4;
    padding: 2px 8px;
    min-height: 24px;
    font-weight: 600;
}

QToolButton#FinderBreadcrumbRootBtn:hover {
    background: #FFFFFF;
}

QTableWidget#FinderDetailsTable {
    border: 1px solid #EDEBE9;
    border-radius: 8px;
    background: #F8F8F8;
    alternate-background-color: #FFFFFF;
    gridline-color: transparent;
    selection-background-color: #EDE7F6;
    selection-color: #323130;
}

QTableWidget#FinderDetailsTable::item:selected {
    background-color: #EDE7F6;
    color: #323130;
}

QTableWidget#FinderDetailsTable::item:selected:active {
    background-color: #EDE7F6;
    color: #323130;
}

QTableWidget#FinderDetailsTable::item {
    padding: 4px 8px;
    border: none;
}

QHeaderView#qt_scrollarea_viewport::section,
QTableWidget#FinderDetailsTable QHeaderView::section {
    background: #FFFFFF;
    color: #605E5C;
    border: none;
    border-bottom: 1px solid #EDEBE9;
    padding: 6px 8px;
    font-weight: 600;
}

QToolButton#FinderModeBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 10px;
    color: #605E5C;
    min-height: 28px;
    max-height: 28px;
    font-size: 12px;
}

QToolButton#FinderModeBtn:checked {
    background: #0078D4;
    color: #FFFFFF;
    border-color: #0078D4;
    font-weight: 500;
}

QToolButton#FinderModeBtn:hover:!checked {
    background: #FFFFFF;
    color: #323130;
    border-color: #EDEBE9;
}

QToolButton#FinderMenuBtn {
    background: #F8F8F8;
    border: 1px solid #EDEBE9;
    border-radius: 6px;
    padding: 4px 10px;
    padding-right: 22px;
    color: #605E5C;
    min-height: 28px;
    max-height: 28px;
    font-size: 12px;
}

QToolButton#FinderMenuBtn:hover {
    background: #FFFFFF;
    color: #323130;
    border-color: #0078D4;
}

QToolButton#FinderMenuBtn:pressed {
    background: #FFFFFF;
}

QToolButton#FinderMenuBtn[hasMenu="true"]::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 8px;
    height: 8px;
    right: 8px;
    top: 50%;
    margin-top: -4px;
}

QPushButton#NavButton {
    background: #F3F2F1;
    color: #323130;
    border: none;
    min-height: 36px;
    padding: 8px 12px 8px 16px;
    text-align: left;
    outline: none;
}

QPushButton#NavButton:focus {
    outline: none;
}

QPushButton#NavButton:hover {
    background: #EDEBE9;
    color: #323130;
    border: none;
}

QPushButton#NavGroupHeader {
    background: #F3F2F1;
    color: #323130;
    border: none;
    min-height: 32px;
    padding: 6px 10px;
    text-align: left;
    font-weight: 700;
    outline: none;
}

QPushButton#NavGroupHeader:focus {
    outline: none;
}

QPushButton#NavGroupHeader:hover {
    background: #EDEBE9;
    color: #323130;
}

QPushButton#NavButton[navItem="true"] {
    padding-left: 22px;
}

QPushButton#NavButton:checked {
    background: #0078D4;
    color: #FFFFFF;
}

QPushButton#NavButton:checked:hover {
    background: #0078D4;
    color: #FFFFFF;
}

QPushButton#ThemePickerBtn {
    background: #F8F8F8;
    color: #323130;
    border: 1px solid #EDEBE9;
    border-radius: 8px;
    min-height: 40px;
    padding: 8px 12px;
    text-align: left;
    outline: none;
}

QPushButton#ThemePickerBtn:focus {
    outline: none;
}

QPushButton#ThemePickerBtn:hover {
    background: #FFFFFF;
    border-color: #A19F9D;
}

QPushButton#ThemePickerBtn:checked {
    background: #FFFFFF;
    border: 2px solid #0078D4;
    color: #323130;
    font-weight: 600;
    padding: 7px 11px;
}

QPushButton#ThemePickerBtn:checked:hover {
    background: #FFFFFF;
    border: 2px solid #0078D4;
}

QWidget#ShellSubHeader {
    background: #F8F8F8;
    border-bottom: 1px solid #EDEBE9;
}

QWidget#ShellFocusExitBar {
    background: #F3F2F1;
    color: #323130;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

QWidget#ShellFocusExitBar QLabel {
    color: #323130;
    font-size: 12px;
}

QToolButton#ShellQuickBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    color: #605E5C;
    font-size: 10pt;
}

QToolButton#ShellQuickBtn:hover {
    background: #FFFFFF;
    color: #323130;
}

QToolButton#ShellQuickBtn:pressed {
    background: #EDEBE9;
}

QToolButton#ShellQuickBtn[hasMenu="true"] {
    padding-right: 24px;
}

QToolButton#ShellQuickBtn[hasMenu="true"]::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 10px;
    height: 10px;
    right: 8px;
    top: 50%;
    margin-top: -5px;
}

QToolButton#ShellDomainBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    color: #605E5C;
    font-size: 10pt;
    font-weight: 500;
}

QToolButton#ShellDomainBtn:hover {
    background: #FFFFFF;
    color: #323130;
}

QToolButton#ShellDomainBtn:checked {
    color: #0078D4;
    font-weight: 600;
    border-bottom: 2px solid #0078D4;
    border-radius: 0px;
    padding-bottom: 4px;
}

QToolButton#ShellDomainBtn:pressed {
    background: #EDEBE9;
}

QPushButton#ShellHeaderBtn,
QToolButton#ShellHeaderBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0;
    margin: 0;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 600;
}

QPushButton#ShellHeaderBtn:hover,
QToolButton#ShellHeaderBtn:hover {
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
}

QPushButton#ShellHeaderBtn[class="danger"]:hover {
    background: rgba(220, 53, 69, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.35);
}

QFrame#ToolLaunchCard {
    background: #F8F8F8;
    border: 1px solid #EDEBE9;
    border-radius: 10px;
    min-height: 88px;
}

QFrame#ToolLaunchCard[hover="true"] {
    background: #FFFFFF;
    border: 1px solid #0078D4;
}

QFrame#MediaStudioLeft {
    background: #F8F8F8;
    border: 1px solid #EDEBE9;
    border-radius: 12px;
}

QPlainTextEdit#MediaStudioPrompt {
    min-height: 80px;
    max-height: 80px;
}

QFrame#MediaStudioLeft QWidget#FormRow {
    min-height: 32px;
}

QFrame#MediaStudioLeft QLabel#FormRowLabel {
    min-width: 44px;
}

QLabel#MediaWorkPlayBadge {
    background: transparent;
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 600;
}

QLabel#HarnessWebOverlay {
    background: rgba(0, 0, 0, 0.45);
    color: #F5F5F7;
    padding: 12px 16px;
}

QScrollArea#MediaStudioLeftScroll {
    background: transparent;
    border: none;
}

QScrollArea#MediaStudioLeftScroll QScrollBar:vertical {
    width: 4px;
    background: transparent;
    margin: 2px 0px;
}

QScrollArea#MediaStudioLeftScroll QScrollBar::handle:vertical {
    background: #C8C6C4;
    min-height: 18px;
    border-radius: 2px;
}

QScrollArea#MediaStudioLeftScroll QScrollBar::add-line:vertical,
QScrollArea#MediaStudioLeftScroll QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollArea#MediaStudioLeftScroll QScrollBar::add-page:vertical,
QScrollArea#MediaStudioLeftScroll QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollArea#MediaStudioFilmScroll QScrollBar:horizontal {
    height: 4px;
    background: transparent;
    margin: 0px 2px;
}

QScrollArea#MediaStudioFilmScroll QScrollBar::handle:horizontal {
    background: #C8C6C4;
    min-width: 18px;
    border-radius: 2px;
}

QScrollArea#MediaStudioFilmScroll QScrollBar::add-line:horizontal,
QScrollArea#MediaStudioFilmScroll QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}

QFrame#MediaStudioVHandle {
    background: #EDEBE9;
    border-radius: 2px;
    margin: 2px 16px;
}

QFrame#MediaStudioVHandle:hover {
    background: #0078D4;
}

QFrame#MediaStudioFooter {
    border-top: 1px solid #EDEBE9;
    padding-top: 4px;
    margin-top: 2px;
}

QFrame#MediaStudioStage {
    background: #F0F0F0;
    border: 1px solid #EDEBE9;
    border-radius: 12px;
}

QLabel#MediaPreviewCanvas {
    background: transparent;
    color: #605E5C;
    padding: 12px;
    font-size: 10pt;
}

QFrame#MediaWorksBlock {
    background: transparent;
    border-top: 1px solid #EDEBE9;
    padding-top: 6px;
}

QLabel#MediaWorkThumb, QLabel#MediaRefThumbImage {
    background: transparent;
}

QFrame#MediaRefThumb {
    background: #FFFFFF;
    border: 1px solid #EDEBE9;
    border-radius: 8px;
}

QFrame#MediaRefThumb:hover {
    border-color: #0078D4;
}

QFrame#MediaRefThumb QPushButton#MediaRefRemoveBtn {
    min-height: 22px;
    max-height: 24px;
    padding: 0px 6px;
    font-size: 9pt;
}

QFrame#MediaRefAddTile {
    background: transparent;
    border: 1px dashed #EDEBE9;
    border-radius: 8px;
}

QFrame#MediaWorkTile {
    background: #FFFFFF;
    border: 1px solid #EDEBE9;
    border-radius: 8px;
}

QFrame#MediaWorkTile:hover {
    border-color: #A19F9D;
    background: #F8F8F8;
}

QFrame#MediaWorkTile[selected="true"] {
    border: 2px solid #0078D4;
    background: #F8F8F8;
}

QFrame#MediaTaskPanel {
    background: #F8F8F8;
    border: 1px solid #EDEBE9;
    border-radius: 12px;
}

QFrame#MediaTaskRow {
    background: #FFFFFF;
    border: 1px solid #EDEBE9;
    border-radius: 8px;
}

QFrame#MediaTaskRow QPushButton {
    min-height: 22px;
    max-height: 22px;
    padding: 0 6px;
    font-size: 9pt;
}

QFrame#MediaTaskRow QProgressBar#MediaTaskProgress {
    min-height: 4px;
    max-height: 4px;
    border-radius: 2px;
}

QFrame#MediaTaskRow QProgressBar#MediaTaskProgress::chunk {
    border-radius: 2px;
}

QLabel#ToolCardTitle {
    font-size: 11pt;
    font-weight: 700;
    color: #323130;
}

QLabel#ToolCardSub, QLabel#ToolCardShortcut {
    font-size: 9pt;
    color: #605E5C;
}

QLabel#ToolCardIcon {
    background: #EDEBE9;
    border-radius: 8px;
}

QMenu {
    background: #F8F8F8;
    color: #323130;
    border: 1px solid #EDEBE9;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #0078D4;
    color: #FFFFFF;
}

QMenu::item:hover {
    background: #0078D4;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background: #EDEBE9;
    margin: 4px 8px;
}
